{
  "name": "rivet-adventure-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm build:desktop && pnpm desktop",
    "build": "pnpm build:desktop",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:legacy": "node --test legacy/tests/*.test.mjs",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "build:web": "tsc -b && vite build",
    "build:desktop": "RIVET_DESKTOP=1 pnpm build:web && node scripts/build-desktop.mjs && node dist-electron/build-rules.cjs",
    "desktop": "electron .",
    "start": "pnpm desktop",
    "package:desktop": "pnpm build:desktop && node scripts/package-desktop.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build:app-icon": "node scripts/build-app-icon.mjs",
    "install:desktop": "pnpm package:desktop && node scripts/install-macos.mjs",
    "dev:site": "vite --config website/vite.config.ts",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "jose": "^6.2.13",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/packager": "20.3.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  },
  "main": "dist-electron/main.cjs",
  "description": "Local D&D character sheets, campaign notebook and source-backed ChatGPT guide",
  "author": "Rivet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nk2580/rivet.git"
  },
  "homepage": "https://nk2580.github.io/rivet/",
  "bugs": {
    "url": "https://github.com/nk2580/rivet/issues"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
