rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'owner@example.test'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validRecord(recordId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion', 'writerVersion', 'kind', 'payload', 'revision', 'updatedAt', 'deleted', 'operationId'])
        && d.keys().hasAll(['schemaVersion', 'writerVersion', 'kind', 'payload', 'revision', 'updatedAt', 'deleted', 'operationId'])
        && d.schemaVersion == 2
        && d.writerVersion == 3
        && d.kind in ['character', 'campaign', 'session', 'note', 'conversation']
        && recordId.matches(d.kind + '__[A-Za-z0-9_-]+')
        && d.payload is string && d.payload.size() <= 200000
        && d.revision is int && d.revision > 0
        && d.updatedAt == request.time
        && d.deleted is bool
        && d.operationId is string && d.operationId.size() > 0 && d.operationId.size() <= 120;
    }
    match /users/{uid}/records/{recordId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRecord(recordId) && request.resource.data.revision == 1;
      allow update: if owner(uid) && validRecord(recordId) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.kind == resource.data.kind;
      allow delete: if false; // Deletions synchronize as recoverable versioned tombstones.
    }
    match /users/{uid}/sheets/main { allow read: if owner(uid); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
