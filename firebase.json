{
  "firestore": {"rules": "firestore.rules"},
  "hosting": {
    "public": "dist", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [{"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}, {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}]
  },
  "emulators": {
    "auth": {"host": "0.0.0.0", "port": 9099},
    "firestore": {"host": "0.0.0.0", "port": 8081},
    "ui": {"enabled": true, "host": "0.0.0.0", "port": 4000},
    "singleProjectMode": true
  }
}
