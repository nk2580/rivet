# Firebase public web configuration. Keep the Firebase project on Spark.
RIVET_AUTH_MODE=connected
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
RIVET_APP_ORIGINS=http://localhost:8088,http://localhost:5173,http://127.0.0.1:5173
# The backend-only service account is needed for durable assistant credentials.
# Never put this in a VITE_ variable or commit .env.
FIREBASE_SERVICE_ACCOUNT_JSON=
# A 32-byte base64 encryption key will be required by the assistant integration.
RIVET_CREDENTIAL_KEY=
RIVET_WEB_PORT=8088
RIVET_API_PORT=8080
